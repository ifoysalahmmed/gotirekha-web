{
  "name": "@gotirekha/web",
  "version": "0.2.0",
  "description": "Shared code for the Gotirekha web sites",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/styles.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "author": {
    "name": "Foysal Ahmmed Limon",
    "url": "https://github.com/ifoysalahmmed",
    "email": "ifoysalahmmed@gmail.com"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0"
  },
  "peerDependencies": {
    "@gotirekha/schemas": "^0.9.0",
    "@hookform/resolvers": "^7.0.3",
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@mantine/notifications": "^9.7.5",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.106.1",
    "react": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gotirekha/schemas": "github:ifoysalahmmed/gotirekha-schemas#v0.9.0",
    "@hookform/resolvers": "7.0.3",
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@mantine/notifications": "9.7.5",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.106.1",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "react": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  }
}
